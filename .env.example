# ============================================================
# Parking Reservation System — environment configuration
#
# `make setup` copies this to .env for you. The only value you
# MUST fill in is GOOGLE_API_KEY. Everything else below already
# matches the bundled docker-compose stack.
# ============================================================

# --- LLM: text generation runs on Ollama (gemma4:31b-cloud) ---
LLM_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://localhost:11434
# Only needed for direct cloud access (OLLAMA_BASE_URL=https://ollama.com).
# Leave blank when using the local Ollama daemon (the default).
OLLAMA_API_KEY=

# --- Embeddings: run on Google — SET THIS ---
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# --- PostgreSQL (defaults match docker-compose) ---
READER_CONNECTION_STRING=postgresql://reader:password@localhost:5432/rag_db
WRITER_CONNECTION_STRING=postgresql://parking_writer:password@localhost:5432/rag_db
SCHEMA=parking

# --- MongoDB Atlas Local (defaults match docker-compose) ---
MONGODB_URI=mongodb://admin:adminpassword@localhost:27017/?directConnection=true

# --- MCP filesystem server: where approved reservations are written ---
ALLOWED_DIR=src/customer_data

# --- Approval mode ---
# true  = reservations go to admin approval via the API / Admin UI
# false = approve interactively in the CLI chat
USE_API_APPROVAL=true

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=parking-reservation
